<section id="search">
    <h1>Search</h1>
    <form action="/movies/search" method="get" class="form">
        <input type="text" class="search" name="title" value="{{filters.title}}" placeholder="Title...">
        <input type="text" class="genre" name="genre" value="{{filters.genre}}" placeholder="Genre...">
        <input type="number" class="year" name="year" value="{{filters.year}}" placeholder="Year...">
        <input type="submit" value="search">
    </form>
</section>

<section id="catalog">
    <div class="band">
        {{#each movies}}
            {{>movie}}
        {{else}}
            <div class="no-posts">
                <p class="no-offer">There are no movies matched...</p>
            </div>
        {{/each}}
    </div>
</section>