<section id="create-cast">
    <div class="createCastSection">
        <div class="info-cast">
            <h2>"You're gonna need a bigger boat." — "Jaws," 1975.</h2>
        </div>

        <form method="post" class="createCastForm">
            <h2>Add Actor</h2>
            <ul class="noBullet">
                <li>
                    <label for="name">Name:</label>
                    <input type="text" class="inputFields" id="name" name="name">
                </li>
                <li>
                    <label for="age">Age:</label>
                    <input type="number" class="inputFields" id="age" name="age">
                </li>
                <li>
                    <label for="placeOfBirth">Place of Birth:</label>
                    <input type="text" class="inputFields" id="placeOfBirth" name="placeOfBirth">
                </li>
                <li>
                    <label for="image">Actor Image:</label>
                    <input type="text" class="inputFields" id="image" name="imageURL">
                </li>
                <li id="center-btn">
                    <button id="create-btn" type="submit">Add Actor</button>
                </li>
            </ul>
        </form>
    </div>
</section>