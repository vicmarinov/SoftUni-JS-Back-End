{{ setTitle 'Edit Mission' }}

<main class="edit-page">
  <div class="glass-card form-card">
    <h2 class="form-title">✏️ Edit Mission</h2>
    <p class="form-sub">Update the mission parameters</p>
    <div class="neon-line"></div>
    <form method="POST">
      <div class="form-grid">
        <div class="form-group">
          <label class="form-label">Mission Name</label>
          <input type="text" class="form-input" name="name" value="{{missionData.name}}" />
        </div>
        <div class="form-group">
          <label class="form-label">Mission Type</label>
          <input type="text" class="form-input" name="type" value="{{missionData.type}}" />
        </div>
        <div class="form-group">
          <label class="form-label">Destination</label>
          <select class="form-input" name="destination">
            {{#each destinations}}
              {{>destination-option}}
            {{/each}}
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Image URL</label>
          <input type="text" class="form-input" name="imageUrl" value="{{missionData.imageUrl}}" />
        </div>
        <div class="form-group">
          <label class="form-label">Crew Members</label>
          <input type="number" class="form-input" name="crew" value="{{missionData.crew}}" min="0" />
        </div>
        <div class="form-group">
          <label class="form-label">Launch Date</label>
          <input type="text" class="form-input" name="launchDate" value="{{missionData.launchDate}}" />
        </div>
        <div class="form-group">
          <label class="form-label">Duration</label>
          <input type="text" class="form-input" name="duration" value="{{missionData.duration}} months" />
        </div>
        <div class="form-group full">
          <label class="form-label">Mission Description</label>
          <textarea class="form-input" name="description">{{missionData.description}}</textarea>
        </div>
      </div>
      <div class="form-actions">
        <button type="submit" class="btn-neon">💾 Save Changes</button>
        <a href="/missions/{{missionData.id}}" class="btn-outline">Cancel</a>
      </div>
    </form>
  </div>
</main>