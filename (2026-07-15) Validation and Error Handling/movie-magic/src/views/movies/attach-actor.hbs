<section id="attachCast">
    <div class="attachCastSection">
        <h1>Attach an Actor to the Cast</h1>

        <div class="attach-form">
            <h2>{{movie.title}}</h2>
            <img class="movie" src="{{movie.imageURL}}">
            <form method="post">
                <ul class="noBullet">
                    <li>
                        <label for="cast">Actor:</label>
                        <select id="cast" name="actor">
                            <option value="" selected disabled>Select Actor</option>
                            {{#each actors}}
                                <option value="{{id}}">{{name}}</option>
                            {{/each}}
                        </select>
                    </li>
                    <li>
                        <label for="roleName">Role Name:</label>
                        <input type="text" id="roleName" name="roleName">
                    </li>
                </ul>

                <div id="center-btn">
                    <button id="create-btn" type="submit">Attach to Cast</button>
                </div>
            </form>
        </div>
    </div>
</section>