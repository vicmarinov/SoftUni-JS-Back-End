<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <title>{{pageTitle}}</title>
        <link href="/css/style.css" type="text/css" rel="stylesheet">
    </head>

    <body>
        <div id="box">
            <nav>
                <img src="/img/logo.webp" alt="logo">

                <ul class="menu">
                    <li><a href="/">Home</a></li>
                    <li><a href="/about">About</a></li>
                    <li><a href="/movies/search">Search</a></li>
                    {{#if user}}
